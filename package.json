{
  "name": "pi-kanban",
  "version": "0.0.0-dev",
  "description": "Workspace for the pi coding agent — sessions, todos, subagents, and more.",
  "main": "server.js",
  "bin": {
    "pi-kanban": "./server.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "build:demo": "node scripts/build-demo.js",
    "preview:demo": "npm run build:demo && npx --yes http-server dist -p 8765 -c-1",
    "site:dev": "npm --prefix website run dev",
    "site:build": "npm --prefix website run build",
    "site:shots": "npm run build:demo && npm --prefix website run shots",
    "release:local": "npm version \"$(git describe --tags --exact-match)\" --no-git-tag-version --allow-same-version && npm publish --access public && git checkout -- package.json package-lock.json",
    "typecheck:extensions": "tsc -p extensions/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/node": "^25.9.9",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "pi-package",
    "kanban",
    "dashboard",
    "observability",
    "sessions",
    "subagents"
  ],
  "files": [
    "server.js",
    "cli.js",
    "lib/",
    "public/",
    "skill-guides/",
    "extensions/",
    "themes/",
    "README.md"
  ],
  "license": "MIT",
  "author": "nikiforovall",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikiforovAll/pi-kanban.git"
  },
  "bugs": {
    "url": "https://github.com/NikiforovAll/pi-kanban/issues"
  },
  "homepage": "https://github.com/NikiforovAll/pi-kanban#readme",
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "chokidar": "^4.0.3",
    "express": "^5.3.0",
    "open": "^11.0.4",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "video": "https://raw.githubusercontent.com/NikiforovAll/pi-kanban/main/assets/pi-kanban-demo.mp4",
    "image": "https://raw.githubusercontent.com/NikiforovAll/pi-kanban/main/assets/pi-kanban-poster.png"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15"
  }
}

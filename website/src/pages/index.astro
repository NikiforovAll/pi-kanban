---
import SiteLayout from '../kit/SiteLayout.astro';
import Shot from '../kit/Shot.astro';
import Keys from '../kit/Keys.astro';
import ModeToggle from '../kit/ModeToggle.astro';
import Lightbox from '../kit/Lightbox.astro';
import FamilyFooter from '../kit/FamilyFooter.astro';
import { url } from '../kit/family';

const GITHUB = 'https://github.com/NikiforovAll/pi-kanban';
const NPM = 'https://www.npmjs.com/package/pi-kanban';
const INSTALL = 'pi install npm:pi-kanban';
const VIDEO = 'https://raw.githubusercontent.com/NikiforovAll/pi-kanban/main/assets/pi-kanban-demo.mp4';

const COST_REPO = 'https://github.com/NikiforovAll/pi-cost';
const INSPECT_REPO = 'https://github.com/NikiforovAll/pi-inspect';

const sections = [
  {
    id: 'run',
    title: 'Run',
    intro: 'Start pi from the board, keep it running when you close the tab, and hand tasks to other sessions.',
    items: [
      {
        title: 'Run pi in the board',
        body: 'Each session opens pi in a terminal next to its board. Close the browser tab and pi keeps running in the board server. Open it again and you are back where you were. [Ctrl+`] shows or hides the terminal.',
        shot: 'terminal',
        alt: 'A pi session in the board terminal, with a show card over its top right corner',
      },
      {
        title: 'Start a session from the board',
        body: 'Click + New or press [Ctrl+Alt+N]. Pick a folder from your projects, then give a name, a first prompt, a model, and a thinking level. [Ctrl+Alt+R] opens the same dialog to resume an older session.',
        shot: 'new-session',
        alt: 'New session dialog with the folder field showing two matching projects',
      },
      {
        title: 'Jump to any session',
        body: '[Ctrl+Shift+P] opens the session picker. Type to filter by name or project. [Tab] switches between the sessions on the board and all sessions, and [Ctrl+Space] peeks at one before you open it.',
        shot: 'session-picker',
        alt: 'The session picker filtered by "rate", with two sessions from acme-api',
      },
      {
        title: 'Hand work to another session',
        body: 'dispatch_start starts a worker session in the board terminal with a self-contained task. The worker sends one report with dispatch_report, and the parent session gets it from dispatch_wait.',
        shot: 'dispatch',
        alt: 'A dispatched load-test session and its log, which ends with the report it sent back',
      },
    ],
  },
  {
    id: 'talk',
    title: 'Talk',
    intro: 'The agent shows you cards and asks you questions on the board. Your answers and comments go back to pi as messages.',
    items: [
      {
        title: 'See what the agent shows you',
        body: 'The show tool posts a markdown or HTML card over the terminal: a table, a chart, a diagram. The card refreshes on each save. Page through the posts, fill the terminal with one, or open it as a tab.',
        shot: 'show',
        size: [1778, 1350],
        alt: 'A show card with a latency bar chart over the top right of the terminal',
      },
      {
        title: 'Answer the agent in place',
        body: 'The ask tool puts an HTML card in a modal: a form, a choice between two layouts, sliders over a preview. pi waits for your answer, and the sidebar counts the sessions that wait on you.',
        shot: 'ask',
        size: [1778, 1350],
        alt: 'An ask modal over the terminal with two layout choices and a Send button',
      },
      {
        title: 'Comment on a doc',
        body: 'Select text in a pane or the preview, press [C], and write a comment. [Ctrl+Enter] sends all the comments to pi as one message, with the quoted text and the file.',
        shot: 'review',
        alt: 'A plan in a pane with two highlighted quotes and their comments in a side panel',
      },
    ],
  },
  {
    id: 'watch',
    title: 'Watch',
    intro: 'The board reads the pi session files and pushes each change to your browser.',
    items: [
      {
        title: 'Todos move as pi works',
        body: 'Pending, in progress, completed. The agents log under the board lists every subagent, and the session log shows each prompt, reply, and tool call in order. [Ctrl+Shift+L] opens it.',
        shot: 'board',
        alt: 'Board with three columns of todos, three document tabs, and the agents log',
      },
      {
        title: 'Read what each subagent did',
        body: 'Open a subagent from the agents log to read its prompt and the full response, rendered as markdown, with its model, status, and run time.',
        shot: 'subagent',
        alt: 'A scout subagent with its response about public routes',
      },
      {
        title: 'Find the session behind the work',
        body: 'Session info shows the id, project, path, tasks folder, and scratchpad, each with a copy button, plus token use and linked documents. [I] opens it for the selected session.',
        shot: 'session-info',
        alt: 'Session info modal with session id, paths, token use, and linked documents',
      },
    ],
  },
  {
    id: 'panes',
    title: 'Panes',
    intro: 'Keep the plan, the dev server, or a report open beside the board, as tabs of the session.',
    items: [
      {
        title: 'Files and pages next to the board',
        body: 'pane_add opens a URL or a local markdown, HTML, text, or image file as a tab. Press [|] to split a tab with the one before it, and [Ctrl+Alt+1…9] to go to a tab. Linked docs open in the preview modal.',
        shot: 'split',
        alt: 'The board split with a markdown plan in a pane on the right',
      },
    ],
  },
];

const companionItems = [
  {
    title: 'pi-cost: what a session costs',
    body: 'Cost, tokens, and models per message, session, and project, with actual and estimated spend. Press [$] on a session, or run /kanban cost in pi.',
    shot: 'cost',
    alt: 'pi-cost in a board tab: the cost of a session as a chart and a table of messages',
  },
  {
    title: 'pi-inspect: what pi loaded',
    body: 'The system prompt, tools, slash commands, skills, and context files of a session. Press [Shift+I] on a session, or run /kanban inspect in pi.',
    shot: 'inspect',
    alt: 'pi-inspect in a board tab: the tools and context a session loaded, grouped by package',
  },
];

const style = [
  {
    title: 'Pick a color theme',
    body: 'Each theme comes in light and dark, and the board passes it on to pi-cost and pi-inspect. [T] switches between light and dark.',
    shot: 'themes',
    alt: 'The color theme menu open over the board',
  },
  {
    title: 'Zen mode: one session',
    body: '[Ctrl+Shift+Z] hides every other session. The sidebar shows the context use, cost, scratchpad, linked docs, and agents of the open session. Press it again to see all sessions.',
    shot: 'zen',
    alt: 'Zen mode: the sidebar shows only redis-rate-limiter with its context, cost, scratchpad, and agents',
  },
  {
    title: 'Zen mode: one group',
    body: 'Select a group header in the sidebar and press [Ctrl+Shift+Z]. The sidebar then shows only the sessions in that group.',
    shot: 'zen-group',
    alt: 'Zen mode for the Release 2.4 group: the sidebar shows only its three sessions',
  },
  {
    title: 'Keep your hands on the keyboard',
    body: 'Arrow keys move through todos, [Tab] switches between the sidebar and the board or the open pane tab, and [\\] hides the sidebar. Press [?] for the full list.',
    shot: 'shortcuts',
    alt: 'Keyboard shortcuts help with board, session, and terminal tabs',
  },
];

const more = [
  { name: 'Groups and pins', body: 'Put sessions in groups. [.] pins a session to the top, and [>] makes the pin sticky.' },
  { name: 'Search', body: 'Find tasks, sessions, and projects from the sidebar.' },
  { name: 'All terminals', body: '[Ctrl+Shift+`] lists the terminals the board runs. End the ones you are done with.', shot: 'terminals', alt: 'The Terminals dialog with two running pi sessions' },
  { name: 'Tool stats', body: 'Counts the tool calls of a session, with failures and their share of the context. Open it from session info.', shot: 'tool-stats', alt: 'Tool statistics for a session: calls, successes, and impact per tool' },
  { name: 'Packages', body: '[Shift+X] lists the pi packages the board reads from, and installs the missing ones.', shot: 'packages', alt: 'The Packages dialog with five installed pi packages' },
  { name: 'Storage manager', body: '[Shift+S] shows what the board keeps in your browser for each session, and clears it.', shot: 'storage', alt: 'The Storage Manager with tabs for sessions, scratchpads, linked docs, and groups' },
  { name: 'Context bar', body: 'Each session card shows how full its context window is.' },
  { name: 'Scratchpad', body: '[N] keeps notes for a session. pi gets a scratch folder for each session too.' },
  { name: 'Messages to pi', body: 'Review comments, card answers, and task moves reach pi as user messages.' },
  { name: 'Install as an app', body: 'The board is a PWA: install it from the browser to get its own window.' },
];

const tools = [
  { name: 'show, ask', body: 'Post a card over the terminal. Ask through a card in a modal and wait for the answer.' },
  { name: 'dispatch_start, dispatch_wait, dispatch_report', body: 'Start a worker session, wait for its report, send a report back. dispatch_list and dispatch_end list and end workers.' },
  { name: 'pane_add, pane_rm, pane_list', body: 'Add a URL or a local file as a tab next to the board, without switching to it.' },
  { name: 'link_doc, unlink_doc, preview_doc', body: 'Link files and URLs to the session, or open a file in the preview modal now.' },
  { name: 'companion_open', body: 'Open pi-cost or pi-inspect for the session as a tab.' },
  { name: '/kanban', body: 'In pi: open the board, open pi-cost or pi-inspect, or pin and link the session.' },
  { name: 'pi-kanban doc | pane | session | group | task | project | dispatch | terminal', body: 'The same board from a shell. pi-kanban help lists the subcommands.' },
];

const setup = [
  { title: 'Install the package', cmd: INSTALL, body: 'It adds the /kanban command and the board tools to pi. Then run npm install -g pi-kanban to get the board command.' },
  { title: 'Start the board', cmd: 'pi-kanban', body: 'Run it in a shell. The board listens on 127.0.0.1:3460 and prints its URL with the access token.' },
  { title: 'Start pi', cmd: '+ New', body: 'Open the URL the board prints and click + New to run pi in the board terminal. For pi started in another terminal, run /kanban open in pi.' },
];

const companions = [
  { name: 'pi-cost', href: '#companions', body: 'The cost of each session, as a tab on the board.' },
  { name: 'pi-inspect', href: '#companions', body: 'What pi loaded into each session, as a tab on the board.' },
  { name: 'pi-subagents', href: 'https://www.npmjs.com/package/pi-subagents', body: 'Starts named subagent sessions. The board shows them under each parent session.' },
  { name: '@juicesharp/rpiv-todo', href: 'https://www.npmjs.com/package/@juicesharp/rpiv-todo', body: 'Todo tracking that the board shows as columns.' },
  { name: '@juicesharp/rpiv-ask-user-question', href: 'https://www.npmjs.com/package/@juicesharp/rpiv-ask-user-question', body: 'Questions from the agent, shown as cards on the board.' },
];
---

<SiteLayout
  title="pi-kanban: an agent development environment for pi"
  description="Run pi coding agent sessions in the browser next to their todos, subagents, and docs. The agent can show you cards, ask you questions, and hand work to other sessions."
  image="og.png"
>
  <div class="page">
    <header class="nav">
      <a class="mark" href={url()}>pi-kanban</a>
      <nav aria-label="Site">
        <a href={url('getting-started/')}>Docs</a>
        <a href={url('demo/')}>Demo</a>
        <a href={GITHUB}>GitHub</a>
        <ModeToggle />
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>An agent development environment for pi.</h1>
        <p class="lede">
          pi-kanban runs your pi sessions in a browser terminal, next to their todos, subagents, and docs. The
          agent can show you a card, ask you a question, open a file beside the board, or hand a task to another session.
          It all runs on your machine.
        </p>
        <div class="actions">
          <div class="cmd">
            <code><span aria-hidden="true">$ </span>{INSTALL}</code>
            <button type="button" class="copy" data-copy={INSTALL}>Copy</button>
          </div>
          <a class="button" href={url('demo/')}>Try the demo</a>
          <a class="button alt" href={url('getting-started/')}>Read the docs</a>
        </div>

        <figure class="hero-shot">
          <Shot themed="terminal" alt="The pi-kanban board: session sidebar, and pi in the board terminal with a show card" eager />
          <figcaption>
            <p>The board in light and dark. Switch the mode at the top of the page and the screenshots follow.</p>
          </figcaption>
        </figure>
      </section>

      <section class="half" aria-labelledby="tour">
        <div class="half-head">
          <h2 id="tour">Tour</h2>
          <p>Browse sessions, open a subagent, and follow the session log as pi works.</p>
        </div>
        <video class="video" controls preload="none" playsinline src={VIDEO} poster={url('shots/themes/pi-board-light.webp')} aria-label="pi-kanban tour"></video>
      </section>

      {
        sections.map((s, i) => (
          <section class="half" aria-labelledby={s.id}>
            <div class="half-head">
              <h2 id={s.id}>{s.title}</h2>
              <p>{s.intro}</p>
              {i === 0 && <p class="aside">The <a href={url('demo/')}>live demo</a> runs in your browser with sample sessions. No install.</p>}
            </div>
            <div class="items">
              {s.items.map((it) => (
                <article class="item">
                  <div class="item-text">
                    <h3>{it.title}</h3>
                    <p><Keys text={it.body} /></p>
                  </div>
                  <Shot themed={it.shot} alt={it.alt} width={it.size?.[0]} height={it.size?.[1]} />
                </article>
              ))}
            </div>
          </section>
        ))
      }

      <section class="half" aria-labelledby="companions">
        <div class="half-head">
          <h2 id="companions" class="long">Add-ons</h2>
          <p>Two pi packages open as tabs on the board, in the board theme, for the session you look at.</p>
          <p class="aside">
            Both also run on their own: <code>/cost</code> and <code>/inspect</code> in pi. <Keys text="[Shift+X]" /> opens Packages, which installs the ones you do not have.
          </p>
        </div>
        <div class="items">
          {
            companionItems.map((it) => (
              <article class="item">
                <div class="item-text">
                  <h3>{it.title}</h3>
                  <p><Keys text={it.body} /></p>
                </div>
                <Shot themed={it.shot} alt={it.alt} />
              </article>
            ))
          }
          <ul class="companions">
            <li>
              <a href={COST_REPO}><code>pi-cost</code></a>
              <code class="step-cmd">pi install npm:pi-cost</code>
            </li>
            <li>
              <a href={INSPECT_REPO}><code>pi-inspect</code></a>
              <code class="step-cmd">pi install npm:pi-inspect</code>
            </li>
          </ul>
        </div>
      </section>

      <section class="half" aria-labelledby="yours">
        <div class="half-head">
          <h2 id="yours">Yours</h2>
          <p>Pick the colors, learn the keys, and hide what you do not need.</p>
        </div>
        <div class="items">
          {
            style.map((it) => (
              <article class="item">
                <div class="item-text">
                  <h3>{it.title}</h3>
                  <p><Keys text={it.body} /></p>
                </div>
                <Shot themed={it.shot} alt={it.alt} />
              </article>
            ))
          }
        </div>
      </section>

      <section class="half" aria-labelledby="more">
        <div class="half-head">
          <h2 id="more">More</h2>
          <p>Smaller things that save time every day.</p>
        </div>
        <div class="items">
          <ul class="more shots">
            {
              more.filter((m) => m.shot).map((m) => (
                <li>
                  <Shot themed={m.shot} alt={m.alt} />
                  <h3>{m.name}</h3>
                  <p><Keys text={m.body} /></p>
                </li>
              ))
            }
          </ul>
          <ul class="more">
            {
              more.filter((m) => !m.shot).map((m) => (
                <li>
                  <h3>{m.name}</h3>
                  <p><Keys text={m.body} /></p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="half" aria-labelledby="tools">
        <div class="half-head">
          <h2 id="tools">Tools</h2>
          <p>The package gives pi these tools and commands. Each one talks to the board on your machine.</p>
        </div>
        <ul class="companions">
          {
            tools.map((t) => (
              <li>
                <code>{t.name}</code>
                <p><Keys text={t.body} /></p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="half" aria-labelledby="extend">
        <div class="half-head">
          <h2 id="extend">Extend</h2>
          <p>pi-kanban shows what other pi packages write. Install these next to it to fill the board.</p>
        </div>
        <ul class="companions">
          {
            companions.map((c) => (
              <li>
                <a href={c.href}><code>{c.name}</code></a>
                <p>{c.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="setup" aria-labelledby="setup">
        <h2 id="setup">Set up in three steps</h2>
        <ol>
          {
            setup.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <code class="step-cmd">{s.cmd}</code>
                <p>{s.body}</p>
              </li>
            ))
          }
        </ol>
        <p class="aside">
          The board listens on loopback only. Its access token travels in the URL fragment, so the browser never sends it
          to a server.
        </p>
      </section>
    </main>

    <FamilyFooter
      current="kanban"
      links={[
        { label: 'MIT license', href: `${GITHUB}/blob/main/LICENSE` },
        { label: 'npm', href: NPM },
        { label: 'GitHub', href: GITHUB },
      ]}
    />
  </div>
  <Lightbox />
</SiteLayout>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1600);
    });
  }
</script>

<style>
  .page {
    width: min(100% - 2rem, 78rem);
    margin-inline: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
  }
  .mark {
    font: 600 1.25rem/1 var(--font-display);
    color: var(--c-ink1);
    text-decoration: none;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font: 500 0.875rem var(--font-mono);
  }
  .nav nav a {
    color: var(--c-ink2);
    text-decoration: none;
  }
  .nav nav a:hover {
    color: var(--c-ink1);
  }

  .hero {
    padding-block: clamp(2.5rem, 7vw, 6rem) 0;
  }
  h1 {
    margin: 0;
    font: 600 clamp(2.5rem, 6.4vw, 5.75rem) / 0.98 var(--font-display);
    letter-spacing: -0.025em;
    max-width: 18ch;
  }
  .lede {
    margin: 1.75rem 0 0;
    max-width: 38rem;
    font-size: 1.1875rem;
    color: var(--c-ink2);
  }
  .actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cmd {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.375rem 0.375rem 1rem;
    background: var(--c-elevated);
    border: 1px solid var(--c-border);
    border-radius: 0.5rem;
    max-width: 100%;
  }
  .cmd code {
    font-size: 0.9375rem;
    white-space: nowrap;
    overflow-x: auto;
  }
  .cmd code span {
    color: var(--c-muted);
  }
  .copy,
  .button {
    font: 500 0.875rem/1 var(--font-mono);
    padding: 0.625rem 0.875rem;
    border-radius: 0.375rem;
    cursor: pointer;
    text-decoration: none;
  }
  .copy {
    color: var(--c-ink2);
    background: transparent;
    border: 1px solid transparent;
    min-width: 5.5rem;
  }
  .copy:hover {
    background: var(--c-hover);
  }
  .button {
    display: inline-flex;
    align-items: center;
    color: var(--c-field);
    background: var(--c-ink1);
    border: 1px solid var(--c-ink1);
  }
  .button:hover {
    background: var(--c-accent-ink);
    border-color: var(--c-accent-ink);
  }
  .button.alt {
    color: var(--c-ink1);
    background: transparent;
    border-color: var(--c-border);
  }
  .button.alt:hover {
    background: var(--c-hover);
  }
  .copy:focus-visible,
  .button:focus-visible,
  .nav a:focus-visible,
  .companions a:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }

  .hero-shot {
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
  }
  .hero-shot figcaption {
    margin-top: 1.25rem;
  }
  .hero-shot figcaption p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--c-ink3);
  }

  .video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--c-border);
    border-radius: 0.75rem;
    background: var(--c-elevated);
  }

  .half {
    margin-top: clamp(5rem, 10vw, 9rem);
    display: grid;
    grid-template-columns: minmax(14rem, 18rem) 1fr;
    gap: 2rem clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .half-head {
    position: sticky;
    top: 2rem;
  }
  .half-head h2 {
    margin: 0 0 1rem;
    font: 600 clamp(3.5rem, 8vw, 6rem) / 0.9 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--c-accent-ink);
  }
  .half-head h2.long {
    font-size: clamp(3rem, 4.2vw, 4.25rem);
    white-space: nowrap;
  }
  .half-head p {
    margin: 0 0 1rem;
    color: var(--c-ink2);
  }
  .aside {
    font-size: 0.9375rem;
    color: var(--c-ink3);
  }
  .half-head code,
  .aside code {
    font-size: 0.875em;
    padding: 0.1em 0.35em;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 0.3em;
    overflow-wrap: anywhere;
  }
  .items {
    display: grid;
    gap: clamp(3.5rem, 6vw, 5.5rem);
  }
  .item {
    display: grid;
    gap: 1.25rem;
  }
  .item-text {
    max-width: 40rem;
  }
  .item h3,
  .setup h3 {
    margin: 0 0 0.5rem;
    font: 600 1.625rem/1.2 var(--font-display);
    letter-spacing: -0.01em;
  }
  .item p {
    margin: 0;
    color: var(--c-ink2);
  }
  h2 {
    margin: 0 0 1rem;
    font: 600 clamp(2rem, 4vw, 2.75rem) / 1.08 var(--font-display);
    letter-spacing: -0.02em;
  }

  .companions {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }
  .companions li {
    padding: 1rem 1.25rem;
    border: 1px solid var(--c-border);
    border-radius: 0.5rem;
    background: var(--c-surface);
  }
  .companions a {
    font-weight: 600;
  }
  .companions p {
    margin: 0.375rem 0 0;
    color: var(--c-ink2);
  }

  .more {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.75rem 2rem;
  }
